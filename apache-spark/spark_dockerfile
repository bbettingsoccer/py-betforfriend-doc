## build our image on top of Debian latest version
FROM python:3.11.11-slim

LABEL maintainer="ricardomarzcohi@gmail.com"

## initial directory
WORKDIR /home
RUN echo "Hello, World!" > pwd
## comment this line if you prefer to download during the build process
#COPY downloads/* /home/
RUN cat /home/ricardo/spark-defaults.conf /home


# Dowload and install Apache Spark
ENV SPARK_VERSION=3.5.3
RUN wget https://archive.apache.org/dist/spark/spark-$SPARK_VERSION/spark-$SPARK_VERSION-bin-hadoop3.tgz \
    && tar -xzf spark-$SPARK_VERSION-bin-hadoop3.tgz -C /opt \
    #&& ln -s /opt/spark-$SPARK_VERSION-bin-hadoop3 /opt/spark \
    && rm spark-$SPARK_VERSION-bin-hadoop3.tgz

# Set Spark environment variables
ENV SPARK_HOME=/opt/spark-$SPARK_VERSION-bin-hadoop3
ENV PATH=$SPARK_HOME/bin:$PATH


## configure spark
#COPY /home/ricardo/spark-defaults.conf /opt/spark-$SPARK_VERSION-bin-hadoop3/conf
RUN update-alternatives --install "/usr/sbin/start-master" "start-master" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/start-master.sh" 1
RUN update-alternatives --install "/usr/sbin/start-slave" "start-slave" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/start-slave.sh" 1
RUN update-alternatives --install "/usr/sbin/start-slaves" "start-slaves" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/start-slaves.sh" 1
RUN update-alternatives --install "/usr/sbin/start-all" "start-all" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/start-all.sh" 1
RUN update-alternatives --install "/usr/sbin/stop-all" "stop-all" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/stop-all.sh" 1
RUN update-alternatives --install "/usr/sbin/stop-master" "stop-master" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/stop-master.sh" 1
RUN update-alternatives --install "/usr/sbin/stop-slaves" "stop-slaves" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/stop-slaves.sh" 1
RUN update-alternatives --install "/usr/sbin/stop-slave" "stop-slave" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/stop-slave.sh" 1
RUN update-alternatives --install "/usr/sbin/spark-daemon.sh" "spark-daemon.sh" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/spark-daemon.sh" 1
RUN update-alternatives --install "/usr/sbin/spark-config.sh" "spark-config.sh" "/opt/spark-$SPARK_VERSION-bin-hadoop3/sbin/spark-config.sh" 1
RUN update-alternatives --install "/usr/bin/spark-shell" "spark-shell" "/opt/spark-$SPARK_VERSION-bin-hadoop3/bin/spark-shell" 1
RUN update-alternatives --install "/usr/bin/spark-class" "spark-class" "/opt/spark-$SPARK_VERSION-bin-hadoop3/bin/spark-class" 1
RUN update-alternatives --install "/usr/bin/spark-sql" "spark-sql" "/opt/spark-$SPARK_VERSION-bin-hadoop3/bin/spark-sql" 1
RUN update-alternatives --install "/usr/bin/spark-submit" "spark-submit" "/opt/spark/bin/spark-submit" 1
RUN update-alternatives --install "/usr/bin/pyspark" "pyspark" "/opt/spark-$SPARK_VERSION-bin-hadoop3/bin/pyspark" 1
RUN update-alternatives --install "/usr/bin/load-spark-env.sh" "load-spark-env.sh" "/opt/spark-$SPARK_VERSION-bin-hadoop3/bin/load-spark-env.sh" 1


# Install PySpark
RUN pip install pyspark


## expose for ssh
EXPOSE 22
## expose for spark use
EXPOSE 7000-8000
## expose for master webui
EXPOSE 8080
## expose for slave webui
EXPOSE 8081
